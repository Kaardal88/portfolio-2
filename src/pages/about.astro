---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';


const principles = [
  { title: 'Human-first', text: 'I love to think about the user and how they use the product. I always want to discuss new features with my clients and users.' },
  { title: 'Ship, then improve', text: 'I believe in shipping early and often, then iterating based on feedback.' },
  { title: 'Curiosity is a skill', text: 'I always stay curious and explore new ideas, which helps me bring fresh perspectives to client work.' },
];
const skills = ['[HTML]', '[CSS]', '[JavaScript]', '[TypeScript]', '[React]', '[Astro]', '[Figma]', '[Git]', '[NextJs]', '[Tailwind]', '[AI]', '[Postgres]', '[Supabase]'];
---

<BaseLayout
  title="About"
  description="Frontend developer with an eye for UX and a habit of building things. How I work, the tools I reach for, and what I do after hours."
  image="/images/kimmen.jpg"
  imageAlt="Portrait of Kim-André Kårdal"
>
  <section class="container about">
    <div class="about__photo">
      <img src="/images/kimmen.jpg" alt="Portrait of Kim-André Kårdal" decoding="async" />

    </div>
    <div class="about__text">
      <p class="eyebrow">About</p>
      <h1 class="display about__title">Same brain.<br /><span class="accent">More ideas.</span></h1>
      <p class="about__lead">
        I am a frontend developer who likes to combine my love for music, art and making things with my hands with my work. I'm located outside Bergen, Norway. I have a thing for building things that matters to people, and I like to do it in a way that is human-first, easy to use and last but not least, fun and creative!
      </p>
      <p class="about__body">

      </p>
      <div class="about__actions">
        <a class="btn" href="/contact/">Work with me <Icon name="arrow-right" size={18} /></a>

      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <p class="eyebrow">How I work</p>
      <ul class="principles" role="list">
        {
          principles.map((p, i) => (
            <li class="principle">
              <span class="mono accent">{String(i + 1).padStart(2, '0')}</span>
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow skills__label">Tools I reach for</p>
      <ul class="skills" role="list">
        {skills.map((s) => <li class="chip">{s}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-9);
  }
  .about__ph {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .about__title {
    font-size: var(--text-hero);
  }
  .about__lead {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.5;
    color: var(--color-text-soft);
  }
  .about__body {
    max-width: 40rem;
    color: var(--color-text-body);
  }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    margin-top: var(--space-3);
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-5) 0 var(--space-8);
    padding: 0;
  }
  .principle {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }
  .principle h2 {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .principle p {
    color: var(--color-text-muted);
  }
  .skills__label {
    margin-bottom: var(--space-4);
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }
  @media (max-width: 960px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .about__photo {
      max-width: 22rem;
    }
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
