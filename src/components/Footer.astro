---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <span class="mono footer__small">© {year} {site.name}</span>
    <ul class="footer__links">
      <li><a href={site.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>

    </ul>
    <span class="mono footer__small footer__motto">Same brain. More ideas.</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6);
  }
  .footer__small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .footer__motto {
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .footer__links {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__links a {
    display: inline-block;
    padding: var(--space-3) 0;
    font-size: 0.9375rem;
    color: var(--color-text-soft);
  }
  .footer__links a:hover {
    color: #fff;
  }
</style>
