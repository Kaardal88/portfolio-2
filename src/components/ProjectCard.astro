---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { title, category, shortSummary, badge, cover, coverAlt } = project.data;
const num = String(index + 1).padStart(2, '0');
---

<article class="card">
  <div class="card__media">
    {
      cover ? (
        <img src={cover} alt={coverAlt ?? ''} loading="lazy" decoding="async" />
      ) : (
        <div class="placeholder card__placeholder">[{title} screenshot]</div>
      )
    }
    <span class="card__num mono" aria-hidden="true">{num}</span>
    {badge && <span class="card__badge mono">{badge}</span>}
  </div>
  <div class="card__body">
    <span class="card__meta mono">{category}</span>
    <h3 class="card__title">
      <a href={`/work/${project.id}/`} class="card__link">{title}</a>
    </h3>
    <p class="card__text">{shortSummary}</p>
    <div class="card__footer">

      <span class="link-arrow" aria-hidden="true">Read case <Icon name="arrow-right" /></span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    transform: translateY(-4px);
  }
  .card:hover .link-arrow {
    gap: var(--space-4);
  }
  .card__media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  /* Absolute so the image never stretches the 16:11 box, whatever its own proportions. */
  .card__media img,
  .card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .card__num {
    position: absolute;
    left: var(--space-5);
    top: var(--space-5);
    font-size: var(--text-lg);
    letter-spacing: 0.14em;
    color: var(--color-white);
    background: rgba(20, 20, 20, 0.5);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-pill);
  }
  .card__badge {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(92, 79, 179, 0.85);
    color: #fff;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-6) var(--space-6);
  }
  .card__meta {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .card__title {
    font-size: 2.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  /* The whole card is clickable, but only the title is the real link (better for screen readers). */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .card__text {
    flex: 1;
    color: var(--color-text-muted);
  }
  .card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .card__improved {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
